# Сервис systemd. Ставится скриптом deploy/install.sh
[Unit]
Description=linkhub chat bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=linkhub
Group=linkhub
WorkingDirectory=/opt/linkhub
ExecStart=/opt/linkhub/.venv/bin/python -m bot
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=20
Environment=PYTHONUNBUFFERED=1

# бот пишет только в свою папку data
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/linkhub/data
MemoryMax=300M

[Install]
WantedBy=multi-user.target
