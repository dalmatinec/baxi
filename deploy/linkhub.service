# Сервис systemd. Ставится скриптом deploy/install.sh
[Unit]
Description=linkhub chat bot
After=network-online.target
Wants=network-online.target
# никогда не сдаваться: даже после серии падений systemd снова поднимет бота
StartLimitIntervalSec=0

[Service]
Type=simple
User=linkhub
Group=linkhub
WorkingDirectory=/opt/linkhub
ExecStart=/opt/linkhub/.venv/bin/python -m bot
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=20
Environment=PYTHONUNBUFFERED=1

# бот пишет только в свою папку data
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# instances: сюда основной бот пишет сроки оплаты копий white label (папки может не быть)
ReadWritePaths=/opt/linkhub/data -/opt/linkhub/instances
# память: с 260 МБ systemd начинает поджимать, выше 300 МБ перезапускает (а не весь сервер встаёт)
MemoryHigh=260M
MemoryMax=300M

[Install]
WantedBy=multi-user.target
