# Токен от @BotFather
BOT_TOKEN=
# Твой Telegram ID (узнать: @userinfobot). Несколько через запятую
OWNER_IDS=

# Нейросеть. Пусто в AI_API_KEY = бот работает только на фразах из базы
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat
# Цена модели, $ за 1 млн токенов (для подсчёта расхода). Сверь с ценами на сайте сервиса
PRICE_IN=0.30
PRICE_OUT=1.20
# Сколько $ можно потратить в сутки. Кончилось — бот до полуночи отвечает фразами
DAILY_LIMIT_USD=0.30

# Сколько последних сообщений чата видит нейросеть
CONTEXT_MESSAGES=20
# Через сколько сообщений человека обновлять заметки о нём (0 = выключить)
MEMORY_EVERY=25

# Настройки для новых чатов (потом меняются в /admin)
DEFAULT_NAME=Марат
DEFAULT_CHANCE=0.04
DEFAULT_AI_SHARE=0.30
DEFAULT_COOLDOWN=90

TZ_NAME=Asia/Almaty
DATA_DIR=data
LOG_LEVEL=INFO
