# Токен от @BotFather
BOT_TOKEN=
# Твой Telegram ID (узнать: @userinfobot). Несколько через запятую
OWNER_IDS=

# Нейросеть. Пусто в AI_API_KEY = бот работает только на фразах из базы
AI_API_KEY=
# Цена модели, $ за 1 млн токенов (для подсчёта расхода). Сверь с ценами на сайте сервиса
PRICE_IN=0.30
PRICE_OUT=1.20
# Сколько $ можно потратить в сутки. Кончилось — бот до полуночи отвечает фразами
DAILY_LIMIT_USD=0.30

# Сколько последних сообщений чата видит нейросеть
CONTEXT_MESSAGES=20
# Через сколько сообщений человека обновлять заметки о нём (0 = выключить)
MEMORY_EVERY=25

# Настройки для новых чатов (потом меняются в /admin)
# имя бота в новых чатах; пусто = имя из профиля бота в Telegram
DEFAULT_NAME=
DEFAULT_CHANCE=0.04
DEFAULT_AI_SHARE=0.30
DEFAULT_COOLDOWN=90

TZ_NAME=Asia/Almaty
DATA_DIR=data
LOG_LEVEL=INFO

# ---------- Оплата рекламы в USDT: сеть TON и/или TRON (TRC20) ----------
# Адрес кошелька для приёма (UQ... или EQ...). Пусто: заказчикам пишет поддержка, оплату отмечаешь вручную
PAY_TON_ADDRESS=
# Бесплатный ключ toncenter (бот @tonapibot): без ключа 1 запрос в секунду, этого тоже хватает
TONCENTER_API_KEY=
# Адрес USDT TRC20 (начинается на T). Пусто: TRON не принимаем
PAY_TRON_ADDRESS=
# Бесплатный ключ TronGrid (trongrid.io), можно пусто
TRONGRID_API_KEY=
# Канал для формата «закреп в канале» (бот админ с правом закреплять), например -1001234567890
AD_CHANNEL_ID=
# Сколько часов ждать одобрения нового чата, потом бот сам выходит
APPROVAL_HOURS=24
# Пробный период в днях (кнопка в заявке)
TRIAL_DAYS=3
# Создатель бота: бот его хвалит и советует заказывать у него проекты. Пусто = выключено.
# По умолчанию у основного бота имя Сатпаев, а id берутся из OWNER_IDS
CREATOR_NAME=Сатпаев
CREATOR_ALIASES=Сатпаев,Satpaev
# Контакт для заказа проектов, например @username. Пусто: возьму юзернейм владельца из базы
CREATOR_CONTACT=
